**/.ipynb_checkpoints/*
**/__pycache__/*
**/Untitled*.ipynb
**/.DS_Store
.pytest_cache/
paper/
_dm_backup/
.claude/

# Generated figures and notebooks output
figures/
paper.mplstyle

# Example outputs (generated at runtime; directory is tracked via .gitkeep)
examples/output/*
!examples/output/.gitkeep

# Generated/cached HDF5 artifacts.  plotting_data.h5 is deliberately tracked:
# it is small (~70 kB) and lets the paper figures be re-rendered from a clean
# clone without re-running the samplers or downloading the data releases.
resources/example_detector_response_old.h5

# Data releases (large, not distributed with the package).  The paper_plots
# README has users symlink these in, so match symlinks as well as directories.
resources/data_releases/*
!resources/data_releases/README.md

# Generated outputs in paper_plots
scripts/paper_plots/*.pdf
scripts/paper_plots/*.png
scripts/paper_plots/*.h5

# Artifacts the example scripts write beside themselves: cached flux and
# J-factor grids (leading underscore) and the figures they render.
examples/_*.h5
examples/*.png

# scratch directory (local working copies of removed scripts)
scratch/

# Debug scripts
scripts/debug_atmo_rates.py
